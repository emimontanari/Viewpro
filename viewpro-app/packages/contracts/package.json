{
  "name": "@viewpro/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint --config ../../.oxlintrc.node.json --deny-warnings src test",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run test/runtime-contract.spec.ts",
    "generate": "echo 'OpenAPI generation not configured yet'",
    "check": "echo 'OpenAPI contract check not configured yet'"
  },
  "devDependencies": {
    "oxlint": "^1.57.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
