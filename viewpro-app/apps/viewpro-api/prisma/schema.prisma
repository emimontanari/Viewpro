generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. Neon PgBouncer) for the running app.
  url       = env("DATABASE_URL")
  // Direct connection for migrations/introspection, which cannot run over a
  // pooler. Falls back to DATABASE_URL in dev/test/CI where no pooler exists.
  directUrl = env("DIRECT_URL")
}

enum OperatorStatus {
  ACTIVE
  SUSPENDED
}

enum PlatformOperatorRole {
  OWNER
  OPERATIONS
  ANALYST
}

model Operator {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  status       OperatorStatus       @default(ACTIVE)
  role         PlatformOperatorRole @default(ANALYST)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

/// Mirror of InmoView platform outbox events — deduped by sourceEventId (D5, D8).
model PlatformMirrorEvent {
  id            String   @id @default(uuid())
  sourceEventId String   @unique
  eventType     String
  tenantId      String
  newStatus     String
  occurredAt    DateTime
  /// W1: BigInt matches the producer BIGSERIAL (platform_outbox_events.seqNo).
  seqNo         BigInt
  ingestedAt    DateTime @default(now())
  payload       Json

  @@index([tenantId, seqNo])
  @@map("platform_mirror_events")
}

/// Single-row cursor tracking the last successfully ingested seqNo (D7).
model PlatformIngestCursor {
  id    Int    @id @default(1)
  /// W1: BigInt matches the producer BIGSERIAL (platform_outbox_events.seqNo).
  seqNo BigInt @default(0)

  @@map("platform_ingest_cursor")
}

/// Operator-facing tenant registry projection (Phase 7 slice 2A).
/// Upserted from the data-lane feed: TENANT_REGISTERED (full identity+limits)
/// and TENANT_STATUS_CHANGED (latestStatus + name/slug when present, A8/A9).
/// `latestStatus` is a plain String (mirrors platform_mirror_events.newStatus) —
/// the contract union enforces valid values, avoiding an enum migration (A7).
model PlatformTenant {
  id                           String    @id
  name                         String
  slug                         String
  latestStatus                 String
  maxUsers                     Int?
  maxActivePropertyEngagements Int?
  maxDocumentsStorageMb        Int?
  trialEndsAt                  DateTime?
  /// platform-manual-plans (Slice 4, Part 2), design D4 — the ONLY
  /// command-written column in this otherwise event-sourced projection.
  /// Written by `PlatformTenantRepository.setPlan` (assign-plan endpoint)
  /// and cleared by the drift-clear recompute in `applyLimitsChange` (D5).
  /// `upsertFromRegistered`/`upsertFromStatusChange` never reference `plan`
  /// — no clobber risk, same discipline as `trialEndsAt` present-only.
  plan                         String?
  updatedAt                    DateTime  @updatedAt

  @@map("platform_tenants")
}

enum PlatformAuditSource {
  INMOVIEW_OUTBOX
  VIEWPRO_NATIVE
}

/// Append-only audit trail projection for AUDIT_LOGGED events (vision D3) AND
/// ViewPro-native operator-management actions (A4, platform-operator-management).
/// sourceEventId's own unique constraint is the SOLE dedup mechanism for
/// InmoView-outbox events — AUDIT_LOGGED is never written to
/// platform_mirror_events (A5/A6). Native rows never populate sourceEventId
/// (Postgres unique indexes permit multiple NULLs, so native writes can never
/// collide with — or accidentally dedupe against — outbox-sourced rows).
model PlatformAuditLog {
  id            String              @id @default(uuid())
  sourceEventId String?             @unique
  seqNo         BigInt?
  action        String
  tenantId      String?
  actor         Json
  target        Json?
  previousValue Json?
  newValue      Json?
  occurredAt    DateTime
  createdAt     DateTime            @default(now())
  source        PlatformAuditSource @default(INMOVIEW_OUTBOX)

  @@index([seqNo])
  @@map("platform_audit_log")
}

/// platform-payment-ledger — how an agency paid for a plan.
///
/// Append-only: nothing updates or deletes a recorded payment's monetary
/// fields. A mistaken entry is corrected by recording a REVERSAL row that
/// points at the original through reversalOfPaymentId; both rows survive.
/// A ledger whose rows can be edited in silence proves nothing when
/// reconciling against a bank statement, which is the whole point of this
/// table.
///
/// Amounts are integer minor units (bigint), never floats. Periods are
/// calendar dates (@db.Date), interpreted in America/Argentina/Buenos_Aires,
/// so no timezone conversion can shift a period boundary by a day.
///
/// A tenant's paid-through date is DERIVED from these rows (max periodEnd
/// among non-reversed payments) — deliberately not a column on
/// PlatformTenant, which is an event-sourced projection where a second
/// command-written column tracking another table would be free to drift.
enum PaymentMethod {
  BANK_TRANSFER
  CASH
  MERCADOPAGO_LINK
  OTHER
}

model TenantPayment {
  id               String        @id @default(uuid())
  tenantId         String
  amountMinorUnits BigInt
  currency         String        @default("ARS")
  method           PaymentMethod
  plan             String
  periodStart      DateTime      @db.Date
  periodEnd        DateTime      @db.Date
  receiptReference String?
  note             String?

  recordedByOperatorId String
  recordedAt           DateTime @default(now())

  /// Set only on reversal rows. The @unique constraint is what makes double
  /// reversal impossible in the database — a service-layer check alone loses
  /// to two concurrent requests, and the ledger stops balancing. The 409 the
  /// API returns is the friendly surface over this constraint, not a
  /// replacement for it.
  reversalOfPaymentId String?        @unique
  reversalOfPayment   TenantPayment? @relation("PaymentReversal", fields: [reversalOfPaymentId], references: [id])
  reversedBy          TenantPayment? @relation("PaymentReversal")
  reversalReason      String?

  @@index([tenantId, periodEnd])
  @@index([recordedAt])
  @@map("tenant_payments")
}
