# ViewPro platform control-plane API (@viewpro/platform-api) — env sample.
# Copy to .env for local dev. env.schema.ts fails fast at boot on missing/invalid vars.

NODE_ENV=development
PORT=3002

# Platform database (separate instance from InmoView — Design B isolation).
# Local dev uses the docker-compose Postgres on port 5434.
DATABASE_URL=postgresql://viewpro_platform:viewpro_platform@localhost:5434/viewpro_platform?schema=public
# Direct (non-pooled) connection for Prisma migrations. In prod: DATABASE_URL =
# pooled Neon endpoint, DIRECT_URL = direct endpoint. Local: same value.
DIRECT_URL=postgresql://viewpro_platform:viewpro_platform@localhost:5434/viewpro_platform?schema=public

# --- Secrets (REQUIRED, no default, min 16 chars, and MUST be distinct from each other) ---
# A shared value breaks cross-token isolation and fails fast at boot.
ACCESS_TOKEN_SECRET=change-me-access-token-secret-min16
STEP_UP_TOKEN_SECRET=change-me-step-up-token-secret-min16
# PLATFORM_CONTROL_SECRET must MATCH the same var in apps/api (shared control-lane secret).
PLATFORM_CONTROL_SECRET=change-me-platform-control-secret-min16

# Internal URL of the InmoView product API (apps/api) for the control lane.
INMOVIEW_API_INTERNAL_URL=http://localhost:3001

# CORS origin(s) for the operator console (viewpro-web), comma-separated.
CORS_ORIGIN=http://localhost:3100

# Cookies: secure is forced true in production regardless of this value.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Session windows — ABSOLUTE must be greater than IDLE (guarded at boot).
IDLE_TIMEOUT_SECONDS=600
ABSOLUTE_SESSION_SECONDS=28800
STEP_UP_TTL_SECONDS=300

# Login rate limiting.
AUTH_RATE_LIMIT_LOGIN_LIMIT=5
AUTH_RATE_LIMIT_LOGIN_TTL_SECONDS=60

# Data-lane ingest poll interval (ms).
PLATFORM_POLL_INTERVAL_MS=5000

# Error tracking — leave SENTRY_DSN unset to disable (no-op). Set it in production.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# --- First operator bootstrap ---
# Used ONLY by `pnpm db:seed` (prisma/seed.ts) to create the first OWNER operator.
# Idempotent (upsert by email). MUST be run once per environment on deploy, or
# there is no account to log into the operator console.
SEED_OPERATOR_EMAIL=operator@viewpro.local
SEED_OPERATOR_PASSWORD=change-me-strong-password
