generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. Neon PgBouncer) for the running app — high concurrency.
  url       = env("DATABASE_URL")
  // Direct connection for migrations/introspection, which cannot run over a pooler.
  // Falls back to DATABASE_URL in dev/test/CI where no separate pooler exists.
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum GlobalRole {
  USER
  VIEWPRO_ADMIN
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum TenantRole {
  PRINCIPAL_MANAGER
  MANAGER
  AGENT
}

enum TenantMembershipStatus {
  ACTIVE
  DEACTIVATED
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL
  OTHER
}

enum PropertyOperationType {
  SALE
  RENT
}

enum PropertyEngagementStatus {
  CAPTURE
  DOCUMENTATION_PENDING
  PUBLICATION_PREPARATION
  ACTIVE_PUBLICATION
  INQUIRIES_AND_VISITS
  OFFER_NEGOTIATION
  RESERVATION_STARTED
  FINAL_DOCUMENTATION
  CLOSED
  CANCELLED
}

enum PropertyAssetOwnerAccessStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum OwnerInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum NotificationSurface {
  INTERNAL
  OWNER
}

enum NotificationType {
  DOCUMENT_REQUESTED
  DOCUMENT_UPLOADED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  PROPERTY_STATUS_CHANGED
  MOVEMENT_CREATED
  STATUS_CHANGE_REQUESTED
  STATUS_CHANGE_APPROVED
  STATUS_CHANGE_REJECTED
}

enum StatusChangeRequestStatus {
  PENDING
  RESOLVED
}

enum MovementType {
  GENERAL_UPDATE
  INQUIRY
  VISIT_SCHEDULED
  VISIT_COMPLETED
  OFFER_RECEIVED
  DOCUMENTATION_UPDATE
  STATUS_CHANGE
  ARCHIVED
  RESTORED
}

enum MovementSource {
  MANUAL
  SYSTEM
}

enum InterestLevel {
  LOW
  MEDIUM
  HIGH
}

enum MovementBuiltInOutcome {
  EN_CAPTACION
  DOCUMENTACION_PENDIENTE
  PREPARANDO_PUBLICACION
  PUBLICACION_ACTIVA
  CONSULTAS_Y_VISITAS
  NEGOCIACION_OFERTA
  RESERVA_INICIADA
  DOCUMENTACION_FINAL
  CERRADO
  CANCELADO
}

enum DocumentRequestStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentVersionStatus {
  PENDING_UPLOAD
  UPLOADED
  APPROVED
  REJECTED
}

enum AnalyticsActorType {
  INTERNAL_USER
  OWNER
  SYSTEM
  PLATFORM_OPERATOR
}

enum AnalyticsEventName {
  SELLER_LOGGED_IN
  MOVEMENT_CREATED
  PROPERTY_STATUS_CHANGED
  OWNER_VIEWED_PROPERTY
  DOCUMENT_REQUESTED
  DOCUMENT_UPLOADED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  WHATSAPP_CONTACT_CLICKED
  TENANT_STATUS_CHANGED
  TENANT_LIMITS_UPDATED
  MEMBER_ROLE_CHANGED
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  passwordHash    String
  firstName       String
  lastName        String?
  whatsappPhone   String?
  status          UserStatus         @default(ACTIVE)
  globalRole      GlobalRole         @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  memberships         TenantMembership[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  createdPropertyAssets        PropertyAsset[]
  createdPropertyEngagements   PropertyEngagement[]
  archivedPropertyEngagements  PropertyEngagement[] @relation("PropertyEngagementArchivedBy")
  assignedPropertyEngagements  PropertyAgent[]      @relation("PropertyAgentUser")
  propertyAgentAssignments    PropertyAgent[]      @relation("PropertyAgentAssignedBy")
  movements                   Movement[]
  ownedPropertyAssets         PropertyAssetOwner[]
  requestedDocumentRequests   DocumentRequest[]  @relation("DocumentRequestRequester")
  ownedDocumentRequests       DocumentRequest[]  @relation("DocumentRequestOwner")
  reviewedDocumentRequests    DocumentRequest[]  @relation("DocumentRequestReviewer")
  uploadedDocumentVersions    DocumentVersion[]
  uploadedPropertyImages      PropertyAssetImage[]
  sentTeamInvitations              TeamInvitation[]
  notifications                    Notification[]
  createdMovementOutcomeLabels     TenantMovementOutcomeLabel[]

  statusChangeRequestsRequested StatusChangeRequest[] @relation("StatusChangeRequestRequestedBy")
  statusChangeRequestsResolved  StatusChangeRequest[] @relation("StatusChangeRequestResolvedBy")

  @@map("users")
}

model Tenant {
  id                           String       @id @default(uuid())
  name                         String
  slug                         String       @unique
  status                       TenantStatus @default(TRIAL)
  trialEndsAt                  DateTime?
  whatsappPhone                String?
  maxUsers                     Int?
  maxActivePropertyEngagements Int?
  maxDocumentsStorageMb        Int?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  memberships TenantMembership[]

  propertyEngagements  PropertyEngagement[]
  propertyAgents       PropertyAgent[]
  movements            Movement[]
  documentRequests     DocumentRequest[]
  teamInvitations      TeamInvitation[]
  notifications        Notification[]
  movementOutcomeLabels TenantMovementOutcomeLabel[]
  statusChangeRequests  StatusChangeRequest[]

  @@map("tenants")
}

model TenantMembership {
  id                  String                 @id @default(uuid())
  userId              String
  tenantId            String
  role                TenantRole
  status              TenantMembershipStatus @default(ACTIVE)
  deactivatedAt       DateTime?
  deactivatedByUserId String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([userId])
  @@map("tenant_memberships")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id])
  replacedTokens  RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PropertyAsset {
  id              String       @id @default(uuid())
  title           String
  addressLine     String
  city            String
  province        String
  propertyType    PropertyType
  totalAreaSqm    Int?
  coveredAreaSqm  Int?
  rooms           Int?
  bedrooms        Int?
  bathrooms       Int?
  garages         Int?
  ageYears        Int?
  orientation     String?
  ownerName       String?
  ownerEmail      String?
  createdByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdBy   User                 @relation(fields: [createdByUserId], references: [id])
  engagements PropertyEngagement[]
  owners      PropertyAssetOwner[]
  images        PropertyAssetImage[]
  notifications Notification[]

  @@index([createdByUserId])
  @@index([city, province])
  @@map("property_assets")
}

model PropertyAssetOwner {
  id              String                         @id @default(uuid())
  propertyAssetId String
  userId          String?
  ownerEmail      String
  ownerFirstName  String
  ownerLastName   String
  isPrimary       Boolean                        @default(false)
  accessStatus    PropertyAssetOwnerAccessStatus @default(INVITED)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  propertyAsset    PropertyAsset      @relation(fields: [propertyAssetId], references: [id], onDelete: Cascade)
  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentRequests DocumentRequest[]
  invitations      OwnerInvitation[]

  @@unique([propertyAssetId, ownerEmail])
  @@unique([propertyAssetId, userId])
  @@index([userId, accessStatus])
  @@index([propertyAssetId])
  @@map("property_asset_owners")
}

model OwnerInvitation {
  id                   String                @id @default(uuid())
  propertyAssetOwnerId String
  email                String
  tokenHash            String                @unique
  status               OwnerInvitationStatus @default(PENDING)
  expiresAt            DateTime
  acceptedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  propertyAssetOwner PropertyAssetOwner @relation(fields: [propertyAssetOwnerId], references: [id], onDelete: Cascade)

  @@index([propertyAssetOwnerId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@map("owner_invitations")
}

model TeamInvitation {
  id              String               @id @default(uuid())
  tenantId        String
  email           String
  role            TenantRole
  tokenHash       String               @unique
  status          TeamInvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedByUser User   @relation(fields: [invitedByUserId], references: [id])

  @@index([tenantId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@map("team_invitations")
}

model TenantMovementOutcomeLabel {
  id              String    @id @default(uuid())
  tenantId        String
  label           String    // trimmed, max 40 chars (app-level), unique per tenant via partial index
  color           String?   // CSS hex #RRGGBB, validated at application layer
  createdByUserId String
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdByUserId], references: [id])
  movements Movement[] @relation("MovementCustomOutcomeLabel")

  // NOTE: a partial unique index on (tenantId, label) WHERE deletedAt IS NULL is added
  // via raw SQL in the migration (Prisma cannot express partial unique indexes natively).
  // Do NOT add @@unique([tenantId, label]) here as it would conflict with the partial index.
  @@index([tenantId, deletedAt])
  @@index([createdByUserId])
  @@map("tenant_movement_outcome_labels")
}

model PropertyAssetImage {
  id                 String   @id @default(uuid())
  propertyAssetId    String
  uploadedByUserId   String
  storageKey         String   @unique
  originalFilename   String
  mimeType           String
  sizeBytes          Int
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  propertyAsset PropertyAsset @relation(fields: [propertyAssetId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation(fields: [uploadedByUserId], references: [id])

  @@index([propertyAssetId])
  @@index([uploadedByUserId])
  @@map("property_asset_images")
}

model PropertyEngagement {
  id                  String                   @id @default(uuid())
  tenantId            String
  propertyAssetId     String
  operationType       PropertyOperationType
  status              PropertyEngagementStatus @default(CAPTURE)
  publishedPriceCents Int?
  currency            String                   @default("ARS")
  createdByUserId     String
  archivedAt          DateTime?
  archivedByUserId    String?
  archiveReason       String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyAsset    PropertyAsset     @relation(fields: [propertyAssetId], references: [id], onDelete: Cascade)
  createdBy        User              @relation(fields: [createdByUserId], references: [id])
  archivedBy       User?             @relation("PropertyEngagementArchivedBy", fields: [archivedByUserId], references: [id])
  agents               PropertyAgent[]
  movements            Movement[]
  documentRequests     DocumentRequest[]
  notifications        Notification[]
  statusChangeRequests StatusChangeRequest[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, archivedAt, createdAt])
  @@index([propertyAssetId])
  @@index([createdByUserId])
  @@map("property_engagements")
}

model PropertyAgent {
  id                   String   @id @default(uuid())
  tenantId             String
  propertyEngagementId String
  agentUserId          String
  assignedByUserId     String
  assignedAt           DateTime @default(now())

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyEngagement PropertyEngagement @relation(fields: [propertyEngagementId], references: [id], onDelete: Cascade)
  agentUser          User               @relation("PropertyAgentUser", fields: [agentUserId], references: [id], onDelete: Cascade)
  assignedByUser     User               @relation("PropertyAgentAssignedBy", fields: [assignedByUserId], references: [id])

  @@unique([propertyEngagementId, agentUserId])
  @@index([tenantId, agentUserId])
  @@index([assignedByUserId])
  @@map("property_agents")
}

model Movement {
  id                   String                    @id @default(uuid())
  tenantId             String
  propertyEngagementId String
  createdByUserId      String
  type                 MovementType
  observation          String
  nextStep             String?
  previousStatus       PropertyEngagementStatus?
  newStatus            PropertyEngagementStatus?
  source               MovementSource            @default(MANUAL)
  interestCount        Int?
  visitCount           Int?
  offerAmountCents     Int?
  interestLevel        InterestLevel?
  builtInOutcome       MovementBuiltInOutcome?
  customOutcomeLabelId String?
  createdAt            DateTime                  @default(now())

  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyEngagement  PropertyEngagement          @relation(fields: [propertyEngagementId], references: [id], onDelete: Cascade)
  createdBy           User                        @relation(fields: [createdByUserId], references: [id])
  customOutcomeLabel  TenantMovementOutcomeLabel? @relation("MovementCustomOutcomeLabel", fields: [customOutcomeLabelId], references: [id], onDelete: Restrict)
  notifications       Notification[]

  @@index([tenantId, propertyEngagementId, createdAt])
  @@index([createdByUserId])
  @@index([customOutcomeLabelId])
  @@map("movements")
}

model DocumentRequest {
  id                   String                @id @default(uuid())
  tenantId             String
  propertyEngagementId String
  propertyAssetOwnerId String?
  ownerUserId          String?
  requestedByUserId    String
  title                String
  description          String?
  status               DocumentRequestStatus @default(PENDING)
  reviewedByUserId     String?
  reviewedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyEngagement PropertyEngagement @relation(fields: [propertyEngagementId], references: [id], onDelete: Cascade)
  propertyAssetOwner PropertyAssetOwner? @relation(fields: [propertyAssetOwnerId], references: [id], onDelete: SetNull)
  ownerUser          User?              @relation("DocumentRequestOwner", fields: [ownerUserId], references: [id])
  requestedByUser    User               @relation("DocumentRequestRequester", fields: [requestedByUserId], references: [id])
  reviewedByUser     User?              @relation("DocumentRequestReviewer", fields: [reviewedByUserId], references: [id])
  document           Document?          @relation("DocumentRequestDocument")
  notifications      Notification[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, requestedByUserId])
  @@index([propertyAssetOwnerId, status])
  @@index([ownerUserId, status])
  @@index([propertyEngagementId])
  @@map("document_requests")
}

model Document {
  id                String   @id @default(uuid())
  documentRequestId String   @unique
  currentVersionId  String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  documentRequest DocumentRequest   @relation("DocumentRequestDocument", fields: [documentRequestId], references: [id], onDelete: Cascade)
  currentVersion  DocumentVersion? @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id])
  versions        DocumentVersion[]

  @@map("documents")
}

model DocumentVersion {
  id               String                @id @default(uuid())
  documentId       String
  uploadedByUserId String
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksum         String?
  status           DocumentVersionStatus @default(PENDING_UPLOAD)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  document           Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedByUser     User      @relation(fields: [uploadedByUserId], references: [id])
  currentForDocument Document? @relation("CurrentDocumentVersion")

  @@index([documentId, status])
  @@index([uploadedByUserId])
  @@map("document_versions")
}

model Notification {
  id                   String              @id @default(uuid())
  tenantId             String?
  recipientUserId      String
  surface              NotificationSurface
  type                 NotificationType
  title                String
  body                 String?
  linkHref             String?
  propertyEngagementId String?
  propertyAssetId      String?
  documentRequestId    String?
  movementId           String?
  readAt               DateTime?
  createdAt            DateTime            @default(now())

  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientUser      User                @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  propertyEngagement PropertyEngagement? @relation(fields: [propertyEngagementId], references: [id], onDelete: Cascade)
  propertyAsset      PropertyAsset?      @relation(fields: [propertyAssetId], references: [id], onDelete: Cascade)
  documentRequest    DocumentRequest?    @relation(fields: [documentRequestId], references: [id], onDelete: SetNull)
  movement           Movement?           @relation(fields: [movementId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, surface, readAt, createdAt])
  @@index([tenantId, recipientUserId, surface, createdAt])
  @@index([tenantId, surface, createdAt])
  @@index([propertyEngagementId])
  @@index([propertyAssetId])
  @@index([documentRequestId])
  @@index([movementId])
  @@map("notifications")
}

model AnalyticsEvent {
  id                   String             @id @default(uuid())
  tenantId             String?
  actorUserId          String?
  actorOperatorId      String?
  actorType            AnalyticsActorType
  eventName            AnalyticsEventName
  propertyEngagementId String?
  propertyAssetId      String?
  documentRequestId    String?
  movementId           String?
  metadata             Json?
  occurredAt           DateTime           @default(now())

  @@index([tenantId, eventName, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([propertyEngagementId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([actorOperatorId, occurredAt])
  @@map("analytics_events")
}

model PlatformCommandLog {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  tenantId       String
  commandType    String
  result         Json
  createdAt      DateTime @default(now())

  @@map("platform_command_log")
}

model PlatformOutboxEvent {
  id         String   @id @default(uuid())
  seqNo      BigInt   @default(autoincrement()) @unique
  eventType  String
  tenantId   String
  payload    Json
  occurredAt DateTime

  @@index([occurredAt, seqNo])
  @@map("platform_outbox_events")
}

model StatusChangeRequest {
  id                    String                    @id @default(uuid())
  tenantId              String
  propertyEngagementId  String
  requestedByUserId     String
  targetStatus          PropertyEngagementStatus
  currentStatusSnapshot PropertyEngagementStatus
  requestNote           String?                   // app-validated max 1000
  status                StatusChangeRequestStatus @default(PENDING)
  resolvedByUserId      String?
  resolvedAt            DateTime?
  resolutionComment     String?                   // app-validated max 1000
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyEngagement PropertyEngagement @relation(fields: [propertyEngagementId], references: [id], onDelete: Cascade)
  requestedByUser    User               @relation("StatusChangeRequestRequestedBy", fields: [requestedByUserId], references: [id])
  resolvedByUser     User?              @relation("StatusChangeRequestResolvedBy", fields: [resolvedByUserId], references: [id])

  // NOTE: a partial unique index on (propertyEngagementId) WHERE status='PENDING'
  // is added via raw SQL in the migration (see T-6 / R2 strategy). Do NOT add @@unique here.
  @@index([tenantId, status, createdAt])
  @@index([propertyEngagementId, status])
  @@index([requestedByUserId])
  @@index([resolvedByUserId])
  @@map("status_change_requests")
}
