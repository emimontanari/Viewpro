{
  "name": "viewpro-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "restore:parity": "node scripts/restore-drill/schema-parity.mjs",
    "dev": "turbo watch dev --filter=@viewpro/api --filter=next-shadcn-dashboard-starter",
    "dev:app-new": "turbo dev --filter=@viewpro/api --filter=next-shadcn-dashboard-starter",
    "dev:api": "pnpm --filter @viewpro/api start:dev",
    "dev:platform": "turbo dev --filter=@viewpro/platform-api --filter=viewpro-web",
    "db:platform:up": "docker compose up -d platform-postgres",
    "db:platform:migrate": "pnpm --filter @viewpro/platform-api exec prisma migrate deploy",
    "db:platform:seed": "pnpm --filter @viewpro/platform-api db:seed",
    "build": "turbo build",
    "build:api": "pnpm --filter @viewpro/api build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @viewpro/api db:generate",
    "db:migrate": "pnpm --filter @viewpro/api db:migrate",
    "db:validate": "pnpm --filter @viewpro/api db:validate",
    "db:studio": "pnpm --filter @viewpro/api db:studio",
    "demo:seed": "pnpm --filter @viewpro/api demo:seed",
    "openapi:generate": "pnpm --filter @viewpro/contracts generate",
    "openapi:check": "pnpm --filter @viewpro/contracts check"
  },
  "devDependencies": {
    "turbo": "2.9.12"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.2.0": ">=2.2.0",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "js-yaml@5": "5.2.2",
      "effect@<3.20.0": ">=3.20.0",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "sharp@<0.35.0": ">=0.35.0",
      "postcss@<=8.5.17": ">=8.5.18",
      "@prisma/config@6.19.2>deepmerge-ts": "8.0.1"
    }
  }
}
