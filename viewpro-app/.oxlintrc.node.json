{
  "$schema": "./apps/app-new/node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node", "vitest"],
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/generated/**",
    "**/prisma/migrations/**",
    "**/node_modules/**"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-unused-expressions": "error",
    "no-unsafe-optional-chaining": "error",
    "preserve-caught-error": "error",

    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    // Cannot distinguish NestJS ExceptionFilter.catch(exception, host)
    // from Promise.catch; every hit in this repo is an exception filter.
    "promise/valid-params": "off",
    "promise/no-multiple-resolved": "error",

    "import/no-anonymous-default-export": "warn",
    "import/no-unassigned-import": "off",

    "no-shadow": "off",

    // Off because the rule fights this codebase, not because it finds defects.
    // NestJS modules are decorated empty classes by design; the rule says so itself.
    "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }],
    // `_`-prefixed names are the agreed opt-out for no-unused-vars above, so
    // forbidding the prefix would contradict the rule directly beside it.
    "no-underscore-dangle": "off",
    // Preference for toSorted() over sort(); no defect class behind it.
    "unicorn/no-array-sort": "off",
    // Test factories deliberately live beside the cases they build.
    "unicorn/consistent-function-scoping": "off",
    // 439 hits, all `vi.fn()` without type parameters. Adopting it would be a
    // mechanical rewrite of the entire test suite that catches nothing.
    "vitest/require-mock-type-parameters": "off",
    // Both hits are the fake-timer pattern: the assertion is stored, timers are
    // advanced, then it is awaited. Correct code the rule cannot see.
    "vitest/valid-expect": "off",

    // Deferred, and now with a measured reason rather than a placeholder.
    // 47 sites as of 2026-08-27, up from the 22 recorded a day earlier, and 44
    // of them are `as any` on partial Prisma mocks in two files. The mechanical
    // fix is `as never`, which satisfies the rule and improves nothing; the real
    // fix is typed mock factories, which is a design change to test
    // infrastructure rather than a lint pass. Tracked in #395.
    //
    // Note it needs an explicit severity: it sits outside the correctness and
    // suspicious categories enabled above, so deleting this line turns it OFF
    // rather than on — which is not how the other two deferred rules behaved.
    "typescript/no-explicit-any": "error"

    // Deferred, not dismissed. It rewrites types rather than tidying syntax,
    // so it belongs in a change someone can review case by case. The count is
    // as of 2026-08-26 and is the point of writing it down: a number that grows
    // is visible, a rule that is merely absent is not.
    //
    // The other two are now adopted, and their ratios are the yardstick for
    // this one: no-conditional-expect flagged 20 sites and exactly one was a
    // defect; require-to-throw-message flagged 43 and none were, though it did
    // separate two assertions that had been failing for different reasons
    // while claiming the same thing. Tracked in #395.
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.mts", "**/*.cts"],
      "rules": {
        "constructor-super": "off",
        "no-const-assign": "off",
        "no-dupe-class-members": "off",
        "no-dupe-keys": "off",
        "no-func-assign": "off",
        "no-import-assign": "off",
        "no-new-native-nonconstructor": "off",
        "no-obj-calls": "off",
        "no-redeclare": "off",
        "no-setter-return": "off",
        "no-this-before-super": "off",
        "no-unsafe-negation": "off",
        "no-var": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error"
      }
    }
  ]
}
